        function handleLogin(e) {
            e.preventDefault();
            const id = document.getElementById('teacherId').value.trim().toLowerCase();
            const pass = document.getElementById('teacherPass').value.trim();
            const errorDiv = document.getElementById('loginError');

            if (teachersDB[id] && teachersDB[id].pass === pass) {
                currentTeacher = { username: id, ...teachersDB[id] };
                document.getElementById('loginOverlay').classList.add('hidden');
                document.getElementById('logoutBtn').classList.remove('hidden');
                
                if (currentTeacher.allowed.length === 0) {
                    document.getElementById('addStudentPanel').classList.remove('hidden');
                    document.getElementById('headerSubtitle').innerText = `Logged in as: ${currentTeacher.name} (Full Admin Access)`;
                } else {
                    document.getElementById('headerSubtitle').innerText = `Logged in as: ${currentTeacher.name} (Assigned Sections)`;
                }
                loadData();
            } else {
                errorDiv.innerText = "Invalid Username or Password!";
            }
        }

        function handleLogout() {
            currentTeacher = null;
            document.getElementById('teacherId').value = '';
            document.getElementById('teacherPass').value = '';
            document.getElementById('loginError').innerText = '';
            document.getElementById('loginOverlay').classList.remove('hidden');
            document.getElementById('logoutBtn').classList.add('hidden');
            document.getElementById('addStudentPanel').classList.add('hidden');
        }

        async function loadData() {
            try {
                const response = await fetch(`${API_URL}?action=getData`);
                const result = await response.json();
                
                scores = result.scores && Object.keys(result.scores).length > 0 ? result.scores : {};
                students = result.students && result.students.length > 0 ? result.students : [...defaultStudents];
                feedback = result.feedback || {};
                
                populateStudentDropdown();
                filterData();
            } catch (error) {
                console.error("Error loading data:", error);
                students = [...defaultStudents];
                scores = {};
                feedback = {};
                populateStudentDropdown();
                filterData();
            }
        }

        async function addStudent() {
            if (currentTeacher && currentTeacher.allowed.length > 0) {
                alert('Access Denied: Only administrators can add new students.');
                return;
            }

            const nameInput = document.getElementById('newStudentName');
            const name = nameInput.value.trim();
            const std = document.getElementById('newStudentClass').value;
            const div = document.getElementById('newStudentDiv').value;

            if (!name) { alert('Please enter a student name.'); return; }

            const newStudent = { name, std, div };
            students.push(newStudent);
            nameInput.value = '';
            
            await fetch(API_URL, {
                method: "POST",
                body: JSON.stringify({ action: "addStudent", student: newStudent })
            });

            populateStudentDropdown();
            filterData();
            alert('New student added and synced to Google Sheets!');
        }

        function populateStudentDropdown() {
            const classVal = document.getElementById('classFilter').value;
            const divVal = document.getElementById('divFilter').value;
            const dropdown = document.getElementById('studentDropdown');
            dropdown.innerHTML = '<option value="">-- All Students --</option>';

            students.forEach((student) => {
                const matchClass = (classVal === "ALL" || student.std === classVal);
                const matchDiv = (divVal === "ALL" || student.div === divVal);
                if (matchClass && matchDiv) {
                    const opt = document.createElement('option');
                    opt.value = student.name;
                    opt.textContent = `${student.name} (${student.std} - Div ${student.div})`;
                    dropdown.appendChild(opt);
                }
            });
        }

        function calculateTotal(name) {
            const s = scores[name] || {};
            return (Number(s.disc) || 0) + (Number(s.unif) || 0) + (Number(s.hin) || 0) + 
                   (Number(s.eng) || 0) + (Number(s.mar) || 0) + (Number(s.math) || 0) + 
                   (Number(s.sci) || 0) + (Number(s.dance) || 0) + (Number(s.ict) || 0) + 
                   (Number(s.lib) || 0) + (Number(s.ac) || 0) + (Number(s.ss) || 0);
        }

        function renderTable(filterClass = "ALL", filterDiv = "ALL", searchQuery = "", selectedStudent = "") {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            let srNo = 1;

            students.forEach((student) => {
                if (filterClass !== "ALL" && student.std !== filterClass) return;
                if (filterDiv !== "ALL" && student.div !== filterDiv) return;
                if (selectedStudent && student.name !== selectedStudent) return;
                if (searchQuery && !student.name.toLowerCase().includes(searchQuery.toLowerCase())) return;

                if (!scores[student.name]) {
                    scores[student.name] = { disc: 0, unif: 0, hin: 0, eng: 0, mar: 0, math: 0, sci: 0, dance: 0, ict: 0, lib: 0, ac: 0, ss: 0 };
                }
                if (!feedback[student.name]) {
                    feedback[student.name] = {};
                }

                const s = scores[student.name];
                const total = calculateTotal(student.name);

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${srNo++}</td>
                    <td class="student-name">${student.name}</td>
                    <td>${student.std}</td>
                    <td>Div ${student.div}</td>
                    ${createScoreAndFeedbackCell(student.name, 'disc', Number(s.disc) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'unif', Number(s.unif) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'hin', Number(s.hin) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'eng', Number(s.eng) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'mar', Number(s.mar) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'math', Number(s.math) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'sci', Number(s.sci) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'dance', Number(s.dance) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'ict', Number(s.ict) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'lib', Number(s.lib) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'ac', Number(s.ac) || 0)}
                    ${createScoreAndFeedbackCell(student.name, 'ss', Number(s.ss) || 0)}
                    <td class="total-cell" id="total-${CSS.escape(student.name)}">${total}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function createScoreAndFeedbackCell(name, field, value) {
            const isAllowed = !currentTeacher || currentTeacher.allowed.length === 0 || currentTeacher.allowed.includes(field);
            const currentFb = (feedback[name] && feedback[name][field]) || "";
            const safeId = name.replace(/[^a-zA-Z0-9]/g, '_');

            if (isAllowed) {
                return `
                    <td>
                        <div style="margin-bottom: 4px;">
                            <button class="point-btn" onclick="updatePoint('${name.replace(/'/g, "\\'")}', '${field}', -1)">-</button>
                            <span id="${field}-${safeId}">${value}</span>
                            <button class="point-btn" onclick="updatePoint('${name.replace(/'/g, "\\'")}', '${field}', 1)">+</button>
                        </div>
                        <input type="text" class="feedback-input" id="fb-${safeId}-${field}" value="${currentFb}" placeholder="Remark..." onchange="updateCategoryFeedback('${name.replace(/'/g, "\\'")}', '${field}', this.value)">
                    </td>
                `;
            } else {
                return `
                    <td>
                        <div style="margin-bottom: 4px;">
                            <button class="point-btn disabled" disabled>-</button>
                            <span id="${field}-${safeId}" style="color: #94a3b8;">${value}</span>
                            <button class="point-btn disabled" disabled>+</button>
                        </div>
                        <div style="font-size: 10px; color: #64748b; font-style: italic;">${currentFb || '-'}</div>
                    </td>
                `;
            }
        }

        async function updatePoint(name, field, change) {
            if (currentTeacher && currentTeacher.allowed.length > 0 && !currentTeacher.allowed.includes(field)) {
                alert("Permission Denied: You cannot modify columns assigned to other teachers.");
                return;
            }

            if (!scores[name]) scores[name] = {};
            const currentVal = Number(scores[name][field]) || 0;
            const newVal = currentVal + change;

            if (newVal >= 0 && newVal <= 5) {
                scores[name][field] = newVal;
                const safeId = name.replace(/[^a-zA-Z0-9]/g, '_');
                document.getElementById(`${field}-${safeId}`).innerText = newVal;
                document.getElementById(`total-${CSS.escape(name)}`).innerText = calculateTotal(name);

                await fetch(API_URL, {
                    method: "POST",
                    body: JSON.stringify({ action: "saveScores", scores: scores })
                });
            }
        }

        async function updateCategoryFeedback(name, field, value) {
            if (!feedback[name]) feedback[name] = {};
            feedback[name][field] = value;
            await fetch(API_URL, {
                method: "POST",
                body: JSON.stringify({ action: "saveFeedback", feedback: feedback })
            });
        }

        function filterData() {
            const classVal = document.getElementById('classFilter').value;
            const divVal = document.getElementById('divFilter').value;
            const searchVal = document.getElementById('searchInput').value;
            const studentVal = document.getElementById('studentDropdown').value;
            renderTable(classVal, divVal, searchVal, studentVal);
        }

        async function saveData() {
            await fetch(API_URL, {
                method: "POST",
                body: JSON.stringify({ action: "saveScores", scores: scores })
            });
            await fetch(API_URL, {
                method: "POST",
                body: JSON.stringify({ action: "saveFeedback", feedback: feedback })
            });
            alert('Progress and category remarks successfully synced to Google Sheets!');
        }

        window.onload = function() {
            // Wait for login
        };
    </script>
